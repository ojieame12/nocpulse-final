{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "paths": {
      "@fieldpulse/map": ["packages/map/src/index.ts"],
      "@fieldpulse/module-alerts": ["packages/modules/alerts/src/index.ts"],
      "@fieldpulse/module-auth": ["packages/modules/auth/src/index.ts"],
      "@fieldpulse/module-crop-intelligence": ["packages/modules/crop-intelligence/src/index.ts"],
      "@fieldpulse/module-field-crop-context": ["packages/modules/field-crop-context/src/index.ts"],
      "@fieldpulse/module-field-intake": ["packages/modules/field-intake/src/index.ts"],
      "@fieldpulse/module-field-onboarding": ["packages/modules/field-onboarding/src/index.ts"],
      "@fieldpulse/module-fields": ["packages/modules/fields/src/index.ts"],
      "@fieldpulse/module-hail": ["packages/modules/hail/src/index.ts"],
      "@fieldpulse/module-imagery": ["packages/modules/imagery/src/index.ts"],
      "@fieldpulse/module-integrations": ["packages/modules/integrations/src/index.ts"],
      "@fieldpulse/module-market": ["packages/modules/market/src/index.ts"],
      "@fieldpulse/module-moisture": ["packages/modules/moisture/src/index.ts"],
      "@fieldpulse/module-reports": ["packages/modules/reports/src/index.ts"],
      "@fieldpulse/module-weather": ["packages/modules/weather/src/index.ts"],
      "@fieldpulse/module-workspaces": ["packages/modules/workspaces/src/index.ts"],
      "@fieldpulse/pdf": ["packages/pdf/src/index.ts"],
      "@fieldpulse/platform-config": ["packages/platform/config/src/index.ts"],
      "@fieldpulse/platform-db": ["packages/platform/db/src/index.ts"],
      "@fieldpulse/platform-jobs": ["packages/platform/jobs/src/index.ts"],
      "@fieldpulse/platform-observability": ["packages/platform/observability/src/index.ts"],
      "@fieldpulse/platform-runtime": ["packages/platform/runtime/src/index.ts"],
      "@fieldpulse/platform-storage": ["packages/platform/storage/src/index.ts"],
      "@fieldpulse/raster": ["packages/raster/src/index.ts"]
    }
  }
}
