NODE_ENV=development
NEXT_PUBLIC_APP_NAME=FieldPulse
APP_URL=http://localhost:3000
# Supabase v3 scaffold assumes modern signing keys and API keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPEN_METEO_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
PLANET_API_KEY=
DATABASE_URL=
# Optional development-only selection hints for the first live vertical slice.
DEV_ACTOR_USER_ID=
DEV_WORKSPACE_ID=
# Either R2_ACCOUNT_ID or CLOUDFLARE_ACCOUNT_ID is accepted.
R2_ACCOUNT_ID=
# CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Either R2_BUCKET or R2_BUCKET_NAME is accepted.
R2_BUCKET=
# R2_BUCKET_NAME=
R2_ENDPOINT=
SENTRY_DSN=
# MapTiler – base map tiles for MapLibre GL JS
# Get a key at https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=
# Resend – branded transactional emails (magic link sign-in).
# Get a key at https://resend.com/api-keys
# Without this, falls back to Supabase's default OTP email.
RESEND_API_KEY=
EMAIL_FROM=NocPulse <noreply@nocpulse.com>
# Optional internal recipient for request-access lead notifications.
# Without this, submissions are stored but no email alert is sent.
REQUEST_ACCESS_NOTIFY_EMAIL=
