{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-dev-3001/types/**/*.ts",
    ".next-dev-market/types/**/*.ts",
    ".next-dev-repro/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dev-debug/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/__archive__",
    "**/__archive__/**"
  ]
}
